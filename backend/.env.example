# Ejemplo de archivo .env para el backend
# Copia este archivo a .env y reemplaza los valores por tus credenciales reales.
# NO subas el archivo .env a un repositorio público.

# Puerto del servidor
PORT=5000

# Conexión a MongoDB (ajusta si usas otro host/usuario/clave)
MONGO_URI=mongodb://127.0.0.1:27017/inventory_system

# Clave secreta para firmar JWT
JWT_SECRET=mi_secreto_jwt_cambio

# DeepSeek (API de IA) - define la clave y la URL del endpoint
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.example/endpoint
# Copia este archivo a .env y configura las credenciales
MONGO_URI=mongodb://127.0.0.1:27017/inventory_system
JWT_SECRET=mi_secreto_jwt_cambio
PORT=5000
